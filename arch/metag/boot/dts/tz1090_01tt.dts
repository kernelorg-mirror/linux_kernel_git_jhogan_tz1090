/dts-v1/;

#include "tz1090.dtsi"

&xtal2 {
	clock-frequency = <12000000>;
};

&xtal3 {
	clock-frequency = <32768>;
};

/ {
	model = "ImgTec 01TT Minimorph";
	compatible =	"img,tz1090-01tt", "img,tz1090-01sp",
			"toumaz,tz1090", "img,meta";
};
